# SENTINEL — configurazione (modello neutro)
#
# Copiare in .env e riempire i valori per l'installazione specifica. Il file
# .env NON va mai committato (è escluso in .gitignore): contiene segreti e
# indirizzi propri di ogni deployment.
#
# I segreti si generano con:  openssl rand -hex 32

# ── Base ─────────────────────────────────────────────────────────────
SENTINEL_PORT=8080
SENTINEL_POD_ID=nome-istanza                 # identificativo dell'istanza, es. studio-prod
SENTINEL_LOG_LEVEL=info                       # emergency|alert|critical|error|warning|notice|info|debug
SENTINEL_SAFE_MODE=true                       # true all'avvio: osserva e registra senza bloccare; false quando tarato

# ── Piattaforma protetta (Sentinel sta DAVANTI a questa) ─────────────
PORTAL_INTERNAL_URL=http://127.0.0.1:3000     # backend della piattaforma, raggiungibile solo internamente
PORTAL_PUBLIC_URL=https://DOMINIO-DELLA-PIATTAFORMA
SENTINEL_TRUSTED_IPS=                          # IP fidati (studio), separati da virgola; vuoto = nessuno

# ── Segreti — GENERARE, mai lasciare i segnaposto ────────────────────
SENTINEL_CHALLENGE_SECRET=GENERA-openssl-rand-hex-32
SENTINEL_INTERNAL_SECRET=GENERA-openssl-rand-hex-32
SENTINEL_ESCALATION_WEBHOOK_SECRET=            # solo se si usa il webhook di escalation

# ── Escalation verso il professionista (opzionale) ───────────────────
SENTINEL_ESCALATION_WEBHOOK_URL=               # vuoto = disattivato

# ── Sincronizzazione multi-istanza (opzionale) ──────────────────────
SENTINEL_LEDGER_SYNC_REDIS_URL=                # vuoto = istanza singola; serviva al multi-pod di zeliAI

# ── Modelli ONNX e neural layer ──────────────────────────────────────
SENTINEL_MODELS_PATH=/opt/sentinel/models
SENTINEL_ONNX_MODEL_DIR=/opt/sentinel/models
SENTINEL_LORA_CURSOR_PATH=/opt/sentinel/state/lora.cursor
SENTINEL_PROMPT_INJECTION_ENABLED=true
SENTINEL_PROMPT_INJECTION_THRESHOLD=0.8        # valore di partenza, da tarare sui falsi positivi
SENTINEL_TOXICITY_THRESHOLD=0.8                # valore di partenza, da tarare

# ── GeoIP MaxMind (scaricati da scripts/scarica-geoip.sh) ────────────
GEOIP_DB_PATH=/opt/sentinel/geoip/GeoLite2-City.mmdb
GEOIP_ASN_PATH=/opt/sentinel/geoip/GeoLite2-ASN.mmdb

# ── Regole e liste ───────────────────────────────────────────────────
SENTINEL_CRS_PATH=/opt/sentinel/rules/crs
SENTINEL_DISABLE_WEB_PATTERNS=false
TOR_EXIT_LIST_PATH=/opt/sentinel/data/tor-exits.txt

# ── Solo test ────────────────────────────────────────────────────────
TEST_REDIS_URL=                                # usato solo dalla suite di test; vuoto in produzione
